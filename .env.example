# Copy this file to ".env" and fill in your keys. Never commit .env.

# Coco's AI. The AI keys do NOT go here: they live only on the server, in the Supabase function
# supabase/functions/ai:  npx supabase secrets set GEMINI_API_KEY=your-key   (or ANTHROPIC_API_KEY for Claude)
# Which AI Coco uses: gemini (default), claude, or demo (a built-in sample session, no AI at all).
EXPO_PUBLIC_COCO_AI=gemini
EXPO_PUBLIC_CLAUDE_MODEL=claude-sonnet-5-5
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.8-flash
# Voice → text needs Gemini on the server. Set to 0 to hide it (the keyboard's mic still works).
# EXPO_PUBLIC_VOICE=0

# RevenueCat (app.revenuecat.com → Project → API keys)
# Test Store key works without any App Store / Play account:
EXPO_PUBLIC_RC_TEST_KEY=
# Optional real store keys:
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# Supabase (supabase.com → your project → Connect / Project Settings → API)
# Accounts (email + password) and cloud backup of the forest. The publishable key is meant to ship in
# apps; row level security on the `forests` table keeps each student's data private.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# YouCam API (yce.makeupar.com → API Dashboard → API key): used ONLY to make the picture for a student's
# memory hook. One image = 1 credit. Its key does NOT go here either:
#   npx supabase secrets set YOUCAM_API_KEY=your-key
# Set to 0 to hide the "make a picture" option.
# EXPO_PUBLIC_PICTURES=0

# Qloo (taste AI, used by the onboarding): its key does NOT go here. It lives only on the server, in the
# Supabase function supabase/functions/qloo:  npx supabase secrets set QLOO_API_KEY=your-key
