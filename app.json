{
  "expo": {
    "name": "Drrys",
    "slug": "drrys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "drrys",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.drrys.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Coco listens when you explain ideas out loud."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EAD9CF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.drrys.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EAD9CF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 150
        }
      ],
      "expo-audio",
      "expo-video",
      "expo-notifications",
      "expo-font",
      "expo-document-picker",
      "./plugins/withTestStoreRelease",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88f8b43a-61e4-45e9-99db-8e4034a2a201"
      }
    },
    "owner": "drrys-team"
  }
}
